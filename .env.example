# Kopie als .env.local anlegen und Werte eintragen.
# In Vercel unter Project → Settings → Environment Variables mit denselben Namen setzen.

# Neon: Pooled Connection String (Dashboard → Connect → "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORT@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret für Session-Cookies, z. B. erzeugen mit: openssl rand -hex 32
AUTH_SECRET="..."
